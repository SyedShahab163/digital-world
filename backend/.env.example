# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (production: https://your-domain.com)
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
# Local example. Production: use your hosted database URL (Neon, Supabase, ...).
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/digital_world?schema=public"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# ---- First admin account, created by `npm run seed` ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_MIN_10_CHARS
ADMIN_NAME=Store Admin

# ---- Cloudinary (optional locally: without these, images are stored in ./uploads) ----
# REQUIRED in production on Vercel (the filesystem is read-only/ephemeral, and uploads go browser -> Cloudinary directly).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=digital-world

# ---- Rate limiting (optional locally, REQUIRED in production) ----
# Upstash Redis REST credentials. The Vercel Marketplace integration provides KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Misc ----
# Public URL of this API (only used to build links to locally stored uploads in development)
PUBLIC_API_URL=http://localhost:4000
BUSINESS_TIMEZONE=Asia/Karachi
