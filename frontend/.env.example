# Local development only: where the Express API runs (used by server-side code and the /api + /uploads dev rewrites).
# On Vercel, leave this unset: the app derives its own domain automatically. Set it only if you need to override that.
BACKEND_URL=http://localhost:4000

# Public URL of this website (sitemap, canonical URLs, Open Graph). Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
